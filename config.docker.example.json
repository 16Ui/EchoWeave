{
  "adapter": "onebot-v11",
  "workspace": "/app",
  "provider": "deepseek",
  "model": "deepseek-chat",
  "model_profiles": {
    "demo-echo": {
      "provider": "demo",
      "model": null,
      "label": "Demo / 本地 Echo",
      "description": "不调用外部模型，用于确认 Web、社交平台和会话链路是否打通。"
    },
    "deepseek-chat": {
      "provider": "deepseek",
      "model": "deepseek-chat",
      "label": "DeepSeek Chat",
      "description": "真实 DeepSeek 对话模型，需要在容器环境中设置 DEEPSEEK_API_KEY。"
    },
    "openai-gpt-4.1-mini": {
      "provider": "openai",
      "model": "gpt-4.1-mini",
      "label": "OpenAI GPT-4.1 mini",
      "description": "OpenAI 官方模型，需要在容器环境中设置 OPENAI_API_KEY。"
    },
    "ollama-qwen-coder": {
      "provider": "ollama",
      "model": "qwen2.5-coder:7b",
      "label": "Ollama 本地 Qwen Coder",
      "description": "本地 Ollama 模型，默认连接 http://127.0.0.1:11434/v1，通常不需要 API key。"
    }
  },
  "default_model_profile": "deepseek-chat",
  "rag_enabled": false,
  "rag_backend": "pgvector_hybrid_bgem3",
  "rag_pgvector_dsn": "postgresql://echoweave:echoweave-password@postgres:5432/echoweave",
  "rag_pgvector_table": "echoweave_rag_chunks",
  "rag_embedding_model": "BAAI/bge-m3",
  "rag_auto_index": false,
  "rag_vector_weight": 0.65,
  "rag_bm25_weight": 0.35,
  "rag_query_rewrite_enabled": false,
  "rag_query_rewrite_strategy": "local_multi_query",
  "rag_query_rewrite_max_queries": 3,
  "rag_rerank_enabled": false,
  "rag_rerank_strategy": "bm25",
  "rag_rerank_candidate_multiplier": 4,
  "rag_rerank_original_score_weight": 0.65,
  "rag_rerank_bm25_weight": 0.35,
  "global_enabled_skills": ["search_workspace"],
  "session_enabled_skills": [],
  "state_path": "/app/echoweave-state.json",
  "sandbox_root": "/app/sandboxes",
  "host": "0.0.0.0",
  "port": 8787,
  "webhook_token": "change-me",
  "web_allow_url_token": false,
  "web_session_ttl_seconds": 28800,
  "onebot_api_url": null,
  "onebot_access_token": null,
  "sse_enabled": true,
  "log_file": "/app/logs/echoweave.log",
  "admins": [],
  "allowed_users": [],
  "allowed_groups": [],
  "blocked_users": [],
  "require_mention_in_group": false,
  "bot_ids": [],
  "admin_only_commands": ["approve", "approvals", "bind", "deny", "rag:index", "retry", "revoke", "skill:global"],
  "approval_timeout_seconds": 3600,
  "orphan_recovery_enabled": false,
  "orphan_recovery_scan_interval_seconds": 30.0,
  "orphan_recovery_max_per_scan": 4,
  "orphan_recovery_max_attempts_per_turn": 3,
  "harness_audit_enabled": true,
  "harness_audit_path": "/app/logs/audit.jsonl",
  "harness_policy": {
    "allowed_tools": [],
    "denied_tools": [],
    "allowed_paths": [],
    "denied_paths": [],
    "command_allow_patterns": [],
    "command_approval_patterns": [],
    "command_deny_patterns": [],
    "session_model_allowlist": [],
    "session_skill_allowlist": [],
    "session_rag_enabled": null
  }
}
